# Copy to .env and fill in. .env is gitignored. Do not commit real keys.
# OpenDota: https://www.opendota.com/api-keys — без ключа лимит 60 запросов в минуту.
OPENDOTA_API_KEY=
# Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# STRATZ: https://stratz.com/api after Steam sign-in. STRATZ_API_TOKEN also works.
STRATZ_API_KEY=

# MongoDB. Empty uses mongodb://127.0.0.1:27017/dota. Compose sets the service hostname.
MONGODB_URI=
# Stable Cloudflare Tunnel. Empty uses a temporary *.trycloudflare.com address.
# Origin in the Cloudflare dashboard: http://app:8787 on this machine, http://dota-data:8787 in a cluster.
CLOUDFLARE_TUNNEL_TOKEN=
# ngrok authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
